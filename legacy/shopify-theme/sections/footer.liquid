<footer class="site-footer">
  <div class="footer-grid">
    <div class="footer-brand">
      <a href="{{ routes.root_url }}" class="footer-logo">LAWN<em>IX</em>™</a>
      <div class="footer-tagline">Power · Precision · Performance</div>
      <p>{{ section.settings.brand_desc }}</p>
      <div class="footer-socials">
        {% if section.settings.facebook_url != blank %}
          <a href="{{ section.settings.facebook_url }}" class="social-btn" target="_blank" rel="noopener">f</a>
        {% endif %}
        {% if section.settings.instagram_url != blank %}
          <a href="{{ section.settings.instagram_url }}" class="social-btn" target="_blank" rel="noopener">ig</a>
        {% endif %}
        {% if section.settings.youtube_url != blank %}
          <a href="{{ section.settings.youtube_url }}" class="social-btn" target="_blank" rel="noopener">yt</a>
        {% endif %}
        {% if section.settings.linkedin_url != blank %}
          <a href="{{ section.settings.linkedin_url }}" class="social-btn" target="_blank" rel="noopener">in</a>
        {% endif %}
      </div>
    </div>

    {% for i in (1..3) %}
      {% assign menu_setting = 'menu_' | append: i %}
      {% assign title_setting = 'menu_' | append: i | append: '_title' %}
      <div class="footer-col">
        <h5>{{ section.settings[title_setting] }}</h5>
        <ul>
          {% for link in linklists[section.settings[menu_setting]].links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endfor %}
  </div>

  <!-- NEWSLETTER STRIP -->
  <div class="footer-newsletter">
    <div class="footer-nl-text">
      <strong>Join the Lawnix community</strong>
      <span>Exclusive deals &amp; lawn care tips — no spam, ever.</span>
    </div>
    {% form 'contact', class: 'footer-nl-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="footer-nl-row">
        <input type="email" name="contact[email]" class="footer-nl-input" placeholder="Your email address" required autocomplete="email">
        <button type="submit" class="footer-nl-btn">Subscribe</button>
      </div>
      {% if form.posted_successfully? %}
        <p class="footer-nl-success">✓ You're subscribed!</p>
      {% endif %}
    {% endform %}
  </div>

  <div class="footer-bottom">
    <p>© {{ 'now' | date: '%Y' }} <em>Lawnix™</em>. All Rights Reserved. &nbsp;·&nbsp; Power. Precision. Performance.</p>
    <div class="payment-icons">
      {% for type in shop.enabled_payment_types %}
        <span class="pay-badge">{{ type | replace: '_', ' ' | upcase }}</span>
      {% else %}
        <span class="pay-badge">VISA</span>
        <span class="pay-badge">MC</span>
        <span class="pay-badge">AMEX</span>
        <span class="pay-badge">PAYPAL</span>
        <span class="pay-badge">SHOP PAY</span>
      {% endfor %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "brand_desc", "label": "Brand Description", "default": "Professional-grade lawn tools built for those who take their lawn seriously. No shortcuts. No compromises." },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "youtube_url", "label": "YouTube URL" },
    { "type": "url", "id": "linkedin_url", "label": "LinkedIn URL" },
    { "type": "text", "id": "menu_1_title", "label": "Column 1 Title", "default": "Products" },
    { "type": "link_list", "id": "menu_1", "label": "Column 1 Menu", "default": "footer-products" },
    { "type": "text", "id": "menu_2_title", "label": "Column 2 Title", "default": "Support" },
    { "type": "link_list", "id": "menu_2", "label": "Column 2 Menu", "default": "footer-support" },
    { "type": "text", "id": "menu_3_title", "label": "Column 3 Title", "default": "Company" },
    { "type": "link_list", "id": "menu_3", "label": "Column 3 Menu", "default": "footer-company" }
  ]
}
{% endschema %}
